// Function objects of the transient run. The tracer is solved here (not by a
// separate solver), with the same diffusivity as tracerFoam:
// D = alphaD*nu + alphaDt*nut = nu/Sc + nut/Sct with Sc = 1, Sct = 0.7.

tracer
{
    type            scalarTransport;
    libs            (solverFunctionObjects);
    field           C;
    alphaD          1.0;
    alphaDt         1.428571;
    timeStart       @SPINUP@;       // flow-only spin-up before the tracer starts
    writeControl    writeTime;      // write C only with the other fields (default would be every step)
}

roomTracer
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      cellZone;
    name            room;
    operation       volAverage;
    fields          (C);
    writeFields     false;
    timeStart       @SPINUP@;
    writeControl    timeStep;
    writeInterval   1;
}

tracerRange
{
    type            fieldMinMax;
    libs            (fieldFunctionObjects);
    fields          (C);
    location        false;
    timeStart       @SPINUP@;
    writeControl    timeStep;
    writeInterval   1;
}

speed
{
    type            mag;
    libs            (fieldFunctionObjects);
    field           U;
    result          magU;
    executeControl  timeStep;
    writeControl    writeTime;
}

roomAverage
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      cellZone;
    name            room;
    operation       volAverage;
    fields          (magU);
    writeFields     false;
    writeControl    timeStep;
    writeInterval   1;
}

// Stop with an error if the time step collapses: the flow is diverging. Healthy runs stay above
// 0.001 s; on 2026-10-15 a fine-mesh run fell to 1e-93 s and would have hung for days.
divergenceGuard
{
    type            runTimeControl;
    libs            (utilityFunctionObjects);
    satisfiedAction abort;
    conditions
    {
        timeStepCollapsed
        {
            type        minTimeStep;
            minValue    1e-4;
        }
    }
}

// Flow through each window opening [m^3/s]: sum of the face fluxes over a face zone,
// written every 10 time steps to show how much the flow fluctuates.
@WINDOW_MONITORS@
