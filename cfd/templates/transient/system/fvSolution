FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.05;
    }
    pFinal
    {
        $p;
        relTol          0;
    }
    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.1;
    }
    "(U|k|omega)Final"
    {
        $U;
        relTol          0;
    }
    C
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0;
    }
}

// Two outer correctors with under-relaxation keep PIMPLE stable at the
// Courant numbers of up to @MAX_COURANT@ in the small cells at the windows.
PIMPLE
{
    nOuterCorrectors        2;
    nCorrectors             1;
    nNonOrthogonalCorrectors 1;
    momentumPredictor       yes;
}

relaxationFactors
{
    fields
    {
        p               0.3;
        pFinal          1;
    }
    equations
    {
        "(U|k|omega)"           0.7;
        "(U|k|omega)Final"      1;
    }
}
