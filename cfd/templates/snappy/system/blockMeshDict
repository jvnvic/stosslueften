FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Background mesh of the whole domain: uniform cubes of about @BASE_SIZE@ m.
// snappyHexMesh refines it near the building and cuts out the solid parts.

vertices
(
    (@X0@ @Y0@ 0)  (@X1@ @Y0@ 0)  (@X1@ @Y1@ 0)  (@X0@ @Y1@ 0)
    (@X0@ @Y0@ @Z1@)  (@X1@ @Y0@ @Z1@)  (@X1@ @Y1@ @Z1@)  (@X0@ @Y1@ @Z1@)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (@NX@ @NY@ @NZ@) simpleGrading (1 1 1)
);

boundary
(
    inlet   { type patch;    faces ((0 1 5 4)); }           // south, y = y0 (wind comes in)
    outlet  { type patch;    faces ((3 7 6 2)); }           // north
    sides   { type symmetry; faces ((0 4 7 3) (1 2 6 5)); } // west and east
    top     { type patch;    faces ((4 5 6 7)); }
    ground  { type wall;     faces ((0 3 2 1)); }
);
