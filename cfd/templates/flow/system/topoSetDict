FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

actions
(
    // Cells inside the room -> cellZone "room" (used for room averages).
    {
        name    room;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (0 0 0) (@ROOM_MAX@);
    }
    {
        name    room;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     room;
    }

    // Ground faces inside the room = the room floor. Only snappyHexMesh meshes have
    // such faces (createPatch then moves them to room_walls); for Gmsh meshes the set is empty.
    {
        name    roomFloor;
        type    faceSet;
        action  new;
        source  patchToFace;
        patch   ground;
    }
    {
        name    roomFloor;
        type    faceSet;
        action  subset;
        source  boxToFace;
        box     (0 0 -0.01) (@ROOM_FLOOR_MAX@);
    }
);
