// Values written to postProcessing/ while the solver runs.

residuals
{
    type            solverInfo;
    libs            (utilityFunctionObjects);
    fields          (U p k omega);
}

speed
{
    type            mag;
    libs            (fieldFunctionObjects);
    field           U;
    result          magU;
    executeControl  timeStep;
    writeControl    writeTime;
}

// Mean air speed inside the room: a simple convergence indicator.
roomAverage
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      cellZone;
    name            room;
    operation       volAverage;
    fields          (magU);
    writeFields     false;
    writeControl    timeStep;
    writeInterval   10;
}

// Mean flow over the second half of the iterations. The tracer runs on these fields, so its
// result does not depend on where a slightly oscillating solution stops (PLAN.md §5, finding 5).
flowAverage
{
    type            fieldAverage;
    libs            (fieldFunctionObjects);
    timeStart       @AVERAGE_START@;
    writeControl    writeTime;
    fields
    (
        U   { mean on; prime2Mean off; base iteration; }
        phi { mean on; prime2Mean off; base iteration; }
        nut { mean on; prime2Mean off; base iteration; }
    );
}

// Flow through each window opening [m^3/s]: sum of the face fluxes over a face zone.
@WINDOW_MONITORS@
