FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}

// Tracer diffusivity in tracerFoam: D = nu/Sc + nut/Sct

nu              1.5e-05;    // same as the flow stage [m^2/s]
Sc              1.0;        // molecular; negligible next to turbulent mixing
Sct             0.7;        // turbulent Schmidt number, common for RANS ventilation studies
