FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];   // kinematic pressure p/rho

internalField   uniform 0;

boundaryField
{
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    sides
    {
        type            symmetry;
    }
    "(inlet|top|ground|building|room_walls|sashes)"
    {
        type            zeroGradient;
    }
}
