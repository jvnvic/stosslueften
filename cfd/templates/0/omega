FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform @OMEGA_INIT@;  // log-law value at roof height

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletOmega;
        #include        "include/ABLConditions"
        value           uniform 0;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    top
    {
        type            zeroGradient;
    }
    sides
    {
        type            symmetry;
    }
    "(ground|building|room_walls|sashes)"
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}
